<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!--
    Both exact-alarm permissions are declared, and the pair is deliberate.

    SCHEDULE_EXACT_ALARM is user-grantable, and from Android 14 it is DENIED BY
    DEFAULT for apps that are not clocks or calendars. On its own, a fresh
    install would schedule every bill reminder as an inexact alarm — still
    delivered, but deferrable by hours in Doze — until the user found the
    toggle in system settings themselves.

    USE_EXACT_ALARM is a normal permission granted at INSTALL time with no user
    interaction, which is what makes reminders simply work on a fresh install.

    ⚠️ USE_EXACT_ALARM MUST BE REMOVED BEFORE ANY GOOGLE PLAY SUBMISSION.
    Play restricts it to apps whose core function is an alarm/clock/timer or a
    calendar showing event notifications; a budgeting app requesting it gets the
    listing rejected. It is kept here only because this app is distributed as a
    direct APK download, where no review applies. The moment Play is on the
    table, delete the USE_EXACT_ALARM line — the app already degrades correctly
    without it (NotificationHelper.canScheduleExactAlarms picks the inexact
    schedule mode, and the Notifications screen shows a banner wired to
    requestExactAlarmPermission so the user can grant it).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
    NO storage permissions are declared, deliberately. Every file the app writes
    (backups, CSV, PDF) goes to app-private storage via
    getApplicationDocumentsDirectory()/getTemporaryDirectory(), which needs no
    permission on any API level. Restore/import reads through the Storage Access
    Framework (file_picker issues ACTION_OPEN_DOCUMENT), which grants per-URI
    access without a manifest permission, and sharing goes out through a
    FileProvider. The old READ_EXTERNAL_STORAGE/WRITE_EXTERNAL_STORAGE entries
    were never exercised by any code path and only made the app ask for
    "Files and media" access it does not use.
    -->

    <application
        android:label="FinanceFlow"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Home Screen Widget -->
        <receiver
            android:name=".BudgetWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/budget_widget_info" />
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility?p=3940256099942544 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>