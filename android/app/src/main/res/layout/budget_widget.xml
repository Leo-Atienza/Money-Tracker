<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget, full size: this month's balance, income and expenses,
  and the two quick-add buttons. BudgetWidgetProvider swaps in
  budget_widget_compact when the widget is shorter than this needs.

  RemoteViews inflate only a short list of framework classes (FrameLayout,
  LinearLayout, TextView, ImageView, ImageButton, …). A plain <View> is NOT
  one of them — a <View> divider is what made the old widget show "Can't load
  widget" — so the spacers here are empty FrameLayouts.

  The root is @android:id/background so launchers can animate the app opening
  out of the widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_balance_label_preview"
        android:textColor="@color/widget_on_surface_variant"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_balance"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:autoSizeMaxTextSize="30sp"
        android:autoSizeMinTextSize="16sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center_vertical|start"
        android:maxLines="1"
        android:text="@string/widget_amount_preview"
        android:textColor="@color/widget_on_surface"
        android:textSize="30sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_widget_arrow_up"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_income"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_amount_preview"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_expenses_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_widget_arrow_down"
                android:drawablePadding="4dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/widget_expenses"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_expenses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_amount_preview"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pushes the buttons to the bottom edge however tall the widget is. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_add_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_add_expense_description"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add_expense" />

            <TextView
                android:id="@+id/widget_add_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_add_expense"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_add_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_add_income_description"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_add_income" />

            <TextView
                android:id="@+id/widget_add_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_add_income"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
