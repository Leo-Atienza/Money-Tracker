<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen widget palette, light. Mirrors the app's hand-built neutral
  scheme (lib/theme/luminous_app_theme.dart) and AppColors' status colours
  (ColorContrastHelper.getStatusColors): monochrome chrome, green/red only for
  income/expense. The dark set lives in values-night/widget_colors.xml.
-->
<resources>
    <color name="widget_surface">#FFFAFAFA</color>
    <color name="widget_on_surface">#FF1B1B1B</color>
    <color name="widget_on_surface_variant">#FF5C5C5C</color>
    <color name="widget_button">#FFE6E6E6</color>
    <color name="widget_ripple">#1F1B1B1B</color>
    <color name="widget_income">#FF388E3C</color>
    <color name="widget_expense">#FFD32F2F</color>
    <!--
      Purple (theme_mode 'purple'): the violet tile. BudgetWidgetProvider swaps
      these in; the night set is in values-night. Contrast, computed: ink 13.08:1
      and secondary ink 6.65:1 on the tile; income/expense arrows 3.19/3.85:1;
      button icons 3.84/4.65:1 on the button.
    -->
    <color name="widget_purple_surface">#FFE6DEFF</color>
    <color name="widget_purple_on_surface">#FF1D0A5A</color>
    <color name="widget_purple_on_surface_variant">#FF514185</color>
    <color name="widget_purple_button">#FFF8F6FE</color>
</resources>
